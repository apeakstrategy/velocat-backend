{
  "name": "velocad-backend",
  "version": "1.0.0",
  "description": "VeloCad Engineering REST API Backend",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "prisma validate && node scripts/check-syntax.js",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:import-sqlite": "node scripts/import-sqlite.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "sqlite3": "^6.0.1"
  },
  "prisma": {
    "seed": "node db/seed.js"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
