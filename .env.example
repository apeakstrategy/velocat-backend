# Backend server
PORT=5000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:5173

# Required: generate a unique, cryptographically random value for each environment
JWT_SECRET=replace-with-a-long-random-secret

# Used only to create the initial admin account in a fresh database
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional: use a persistent mounted volume in production; parent directory is created automatically
DB_PATH=./data/velocad.db

# Required only when the protected image-upload endpoint is used
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
