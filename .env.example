# Copy to .env. Never commit the populated .env file.
NODE_ENV=development
PORT=5000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:5173

# MySQL. Replace every placeholder and URL-encode special characters in the password
# (for example, @ becomes %40). Use the provider's direct/non-pooling URL for migrations.
DATABASE_URL=mysql://velocad_user:change-me@127.0.0.1:3306/velocad_db?connection_limit=10
DIRECT_DATABASE_URL=mysql://velocad_user:change-me@127.0.0.1:3306/velocad_db

# Generate a unique random secret of at least 32 characters for each environment.
JWT_SECRET=

# Used by `npm run db:seed` to create the first admin account if one does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=

# Set to 1 only when the app is behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# Use "none" only for cross-site admin/API hosting; production requires HTTPS.
AUTH_COOKIE_SAME_SITE=lax

# Required for protected image uploads to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: set only for a one-time import from the old SQLite database.
# Stop the old backend and point this at a safe copy of its .db file.
# LEGACY_SQLITE_PATH=./legacy/velocad.db
